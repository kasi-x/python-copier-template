{# English rule summaries for the AGENTS.md ethics appendix (agents_md_language == 'en').

   The sections' canonical English wording lives in law-map's guidance
   tree (`guidance/sections/<tier>/<slug>.md` `en:` front-matter blocks,
   CC BY 4.0). This partial mirrors each `status=active`,
   `placement: agents_md` row's `en.title` plus the first three
   `en.summary` lines, snapshot of law-map 8ba7170 — the rulebook revision
   current when the guidance merge landed. Rows follow
   `guidance/sections/MANIFEST.yml` order; `when` is the manifest's
   any-of list (`always` applies to every project). Re-sync a row whenever
   the guidance `en:` block changes; delete this partial once daimonion
   renders English itself.

   The selection replays daimonion's `Section.applies` over the same derived
   condition set `.daimonion.yml` carries (`_shared/daimonion-when.jinja`),
   so the summaries name exactly the sections the block below holds.
   tests/test_daimonion_config.py pins both the rows and the selection
   against the guidance checkout. -#}
{% import "_shared/daimonion-when.jinja" as dw with context -%}
{% set when_set = ['always'] -%}
{% for line in dw.daimonion_when().splitlines() if line.strip() -%}
{% set _ = when_set.append(line.split()[1]) -%}
{% endfor -%}
{% set sections = [
    {'id': 'baseline-copyright-ai', 'when': ['cli', 'data_science'],
     'title': 'AI and copyright — scraping, training and RAG code must keep the non-enjoyment purpose intact',
     'rules': ['Do not bypass robots.txt or other access-refusal measures',
               'Do not design RAG that retrieves and re-emits the protected expression itself; extract facts and concepts',
               'Do not overfit or fine-tune on a specific body of works in order to imitate it']},
    {'id': 'baseline-license-drift', 'when': ['always'],
     'title': 'License drift — track each dependency\u2019s current license and keep BSL/SSPL out',
     'rules': ['Check the current license when adding a dependency and match it against an allowlist',
               'Do not let source-available licenses such as BSL/SSPL in without review',
               'When a project forks (Terraform to OpenTofu, ...), move to the legitimate successor']},
    {'id': 'baseline-personal-data', 'when': ['personal_data', 'face_recognition', 'medtech'],
     'title': 'Personal data — minimise before collecting, and build the deletion path first',
     'rules': ['Ask whether each item is needed before collecting it; default to the minimum',
               'Include deletion and correction paths in the initial design; retrofitting is expensive',
               'Know what leaves the process (error trackers, cloud, external APIs) and reduce it before it leaves']},
    {'id': 'baseline-pki-chain', 'when': ['embedded', 'cli', 'web_api'],
     'title': 'PKI chain changes — do not hard-code intermediate certificates or issuance chains',
     'rules': ['Do not bundle or pin intermediate certificates or issuance chains',
               'Verify against the OS/system trust store and keep a way to update it',
               'If you pin, pin a set of public keys with a backup key, never a single key']},
    {'id': 'baseline-pqc-fips', 'when': ['library', 'cli', 'web_api'],
     'title': 'PQC standards — choose ML-KEM/ML-DSA and hybrids for new cryptography',
     'rules': ['Use the standard names (ML-KEM, ML-DSA, SLH-DSA), not submission names such as Kyber',
               'Key establishment uses ML-KEM; signatures default to ML-DSA with SLH-DSA as the conservative alternative; do not mix the roles',
               'Migrate via hybrids (X25519MLKEM768, ...); do not adopt classical algorithms alone in new designs']},
    {'id': 'domain-contest-rules', 'when': ['oj_code'],
     'title': 'Contest rules — AI use differs per contest, and the submitter is responsible',
     'rules': ['Whether AI may be used differs by contest and over time; check the current rules before generating or submitting',
               'When the rules are unclear, treat AI use as prohibited',
               'The submitter is responsible; multiple accounts and rating manipulation are banned on every judge']},
    {'id': 'domain-face-recognition', 'when': ['face_recognition'],
     'title': 'Face recognition — biometric identification is an exception; confirm the use is lawful first',
     'rules': ['Confirm the use is lawful before implementing; if it is a prohibited use, do not write the code',
               'Handle biometric templates in a non-reversible form, with consent and deletion paths',
               'Measure accuracy per demographic group; do not default to a single threshold']},
    {'id': 'domain-llm-appsec', 'when': ['mcp'],
     'title': 'LLM apps / MCP security — least privilege, human approval and output validation by default',
     'rules': ['Restrict tool permissions to an allowlist of the minimum CRUD needed',
               'Always insert a human approval step before destructive or irreversible operations',
               'Validate LLM output structurally before acting on it; never pass it straight to a shell']},
    {'id': 'domain-ml-bias', 'when': ['data_science', 'kaggle'],
     'title': 'ML bias — build per-group evaluation, explainability and human review into evaluation',
     'rules': ['Always report per-group performance, not just average accuracy',
               'Dropping protected attributes does not remove discrimination; handle proxies',
               'Require human review for decisions that affect life opportunities']},
    {'id': 'domain-scraping-law', 'when': ['scraping'],
     'title': 'Scraping legality — check rights, contracts and personal data before fetching',
     'rules': ["Settle whether you may fetch from each site\u2019s terms and robots.txt first",
               'Even for public data, extracting a substantial part of a database or redistributing expression can infringe other rights',
               'Personal data is regulated both when fetched and when processed']},
    {'id': 'region-eu-cra', 'when': ['commercial'],
     'title': 'EU CRA — vulnerability reporting and SBOMs are no longer optional for commercial software',
     'rules': ['Report actively exploited vulnerabilities within 24 hours of becoming aware',
               'Produce an SBOM so you can account for where every dependency came from',
               'State the support period and ship security updates throughout it']},
    {'id': 'sector-samd-regulatory', 'when': ['medtech'],
     'title': 'Medical SaMD — continuous learning stays inside approved change limits, and humans make the call',
     'rules': ['Do not swap production models outside an approved change plan (PCCP, IDATEN, ...)',
               'Default to a structure where a human (clinician) makes the final decision',
               'Build performance-drift monitoring and post-market surveillance into the initial design']},
] -%}
