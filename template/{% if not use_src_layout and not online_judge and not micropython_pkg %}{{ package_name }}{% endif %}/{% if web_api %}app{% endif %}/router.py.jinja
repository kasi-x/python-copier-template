"""Aggregate all API routers into one `api_router` included by main.py."""

from __future__ import annotations

from fastapi import APIRouter

from {{ package_name }}.app.routers import health
from {{ package_name }}.app.routers import items

api_router = APIRouter()
api_router.include_router(health.router)
api_router.include_router(items.router)

__all__ = ["api_router"]
