"""Demo CRUD router for the Item model.

Shows the patterns you will use for real resources: an async SQLAlchemy
session dependency, pydantic request/response schemas, and a FastAPI
BackgroundTask that runs *after* the response is sent (no extra dependency,
no worker process — see the "add later" notes in the web-api how-to if you
outgrow it).
{% if rate_limit_effective %}
The list endpoint carries a slowapi rate limit; the limiter is attached to
the app in main.py.
{% endif %}
"""

from __future__ import annotations

from collections.abc import Sequence
from typing import Annotated

from fastapi import APIRouter
from fastapi import BackgroundTasks
from fastapi import Depends
from fastapi import HTTPException
{% if rate_limit_effective %}from fastapi import Request
{% endif %}from fastapi import status
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from {{ package_name }}.app.db import get_session
from {{ package_name }}.app.models import Item
{% if rate_limit_effective %}from {{ package_name }}.app.rate_limit import limiter
{% endif %}from {{ package_name }}.app.schemas import ItemCreate
from {{ package_name }}.app.schemas import ItemRead
from {{ package_name }}.logging_setup import logger

router = APIRouter(prefix="/api/v1/items", tags=["items"])

SessionDep = Annotated[AsyncSession, Depends(get_session)]
"""Type alias for the async session dependency (FastAPI `Annotated` style)."""

__all__ = ["router"]


def _log_created(item_id: int, name: str) -> None:
    """Background task: runs after the response has been sent."""
    logger.info("item_created", item_id=item_id, name=name)


@router.post("", response_model=ItemRead, status_code=status.HTTP_201_CREATED)
async def create_item(
    payload: ItemCreate,
    background_tasks: BackgroundTasks,
    session: SessionDep,
) -> Item:
    """Create an item and log it in the background."""
    item = Item(name=payload.name)
    session.add(item)
    await session.commit()
    await session.refresh(item)
    background_tasks.add_task(_log_created, item.id, item.name)
    return item
{% if rate_limit_effective %}


@router.get("", response_model=list[ItemRead])
@limiter.limit("5/minute")  # type: ignore[reportUnknownMemberType] - slowapi ships no stubs
async def list_items(
    request: Request,  # noqa: ARG001 - injected by slowapi for the rate-limit key
    session: SessionDep,
) -> Sequence[Item]:
    """List all items (rate-limited to 5 per minute)."""
    result = await session.execute(select(Item).order_by(Item.id))
    return result.scalars().all()
{% else %}


@router.get("", response_model=list[ItemRead])
async def list_items(session: SessionDep) -> Sequence[Item]:
    """List all items."""
    result = await session.execute(select(Item).order_by(Item.id))
    return result.scalars().all()
{% endif %}


@router.get("/{item_id}", response_model=ItemRead)
async def get_item(item_id: int, session: SessionDep) -> Item:
    """Fetch a single item by id."""
    item = await session.get(Item, item_id)
    if item is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Item not found",
        )
    return item
