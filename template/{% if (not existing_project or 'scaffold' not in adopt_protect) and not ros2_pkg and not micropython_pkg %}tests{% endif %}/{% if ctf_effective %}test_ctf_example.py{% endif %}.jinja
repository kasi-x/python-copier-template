"""CTF workspace test: the solve.py starter must actually run.

Runs the example starter as a subprocess (no binary needed — it exercises
the stdlib packing path) and asserts exit 0 with non-empty output.
"""

import subprocess
import sys
from pathlib import Path


def test_example_solve_runs() -> None:
    root = Path(__file__).resolve().parent.parent
    solve = root / "challenges" / "pwn" / "example" / "solve.py"
    assert solve.exists(), "challenges/pwn/example/solve.py must be generated"
    proc = subprocess.run(
        [sys.executable, str(solve)],
        timeout=30,
        capture_output=True,
        check=False,
    )
    assert proc.returncode == 0, proc.stderr.decode()
    assert len(proc.stdout) > 0
