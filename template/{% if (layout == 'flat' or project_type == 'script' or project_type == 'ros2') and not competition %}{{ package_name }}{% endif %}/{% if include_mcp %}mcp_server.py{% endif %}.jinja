"""MCP (Model Context Protocol) server for {{ package_name }}.

Run with stdio transport:
    uv run mcp run {{ package_name }}.mcp_server:server

Or with SSE transport:
    uv run python -m {{ package_name }}.mcp_server --transport sse
"""

from __future__ import annotations

import argparse
from collections.abc import Sequence

from mcp.server.fastmcp import FastMCP

server = FastMCP("{{ repo_name }}")

__all__ = ["server"]


@server.tool()
def ping() -> str:
    """A simple ping tool."""
    return "pong"


def main(args: Sequence[str] | None = None) -> None:
    """Run the MCP server with stdio (default) or SSE transport."""
    parser = argparse.ArgumentParser(description="MCP server for {{ repo_name }}")
    parser.add_argument(
        "--transport",
        choices=["stdio", "sse"],
        default="stdio",
        help="Transport to use (default: stdio)",
    )
    parsed = parser.parse_args(args)
    if parsed.transport == "sse":
        server.run(transport="sse")
    else:
        server.run(transport="stdio")


if __name__ == "__main__":
    main()
