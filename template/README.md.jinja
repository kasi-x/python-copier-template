# Copy firmware/ to the device root and run it (MicroPython auto-runs /main.py)
{% if package_manager == "uv" %}{% set _run = 'uv run --locked ' %}{% elif package_manager == "poetry" %}{% set _run = 'poetry run ' %}{% else %}{% set _run = 'pixi run -e dev --locked ' %}{% endif %}
{% for f in ['boot.py', 'main.py', 'board_config.py', 'core'] %}{{ _run }}mpremote connect auto fs cp -r firmware/{{ f }} :
{% endfor %}{{ _run }}mpremote connect auto reset
```
{% else %}```sh
{% if package_manager == "uv" %}pip install {{distribution_name}}
{% elif package_manager == "poetry" %}poetry add {{distribution_name}}
{% else %}# pixi project - the environment is managed by pixi
pixi install
{% endif %}
```

