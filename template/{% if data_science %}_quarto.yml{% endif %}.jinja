project:
  execute-dir: project

bibliography: references/references.bib
csl: references/chicago-author-date.csl

# quartodoc generates API reference pages from {{ package_name }} docstrings.
# Run `quarto add machow/quartodoc` once, then `quartodoc build --config _quarto.yml`.
quartodoc:
  package: {{ package_name }}
  dir: docs/reference
  title: API Reference
  renderer:
    style: pkg
