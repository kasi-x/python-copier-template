{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":enableVulnerabilityAlerts"
  ],
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "description": "Keep the {{ "uv.lock" if package_manager == "uv" else "pixi.lock" }} up to date, merging if tests pass",
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Disable python version as that is managed by python-copier-template",
      "matchManagers": [
        "pyenv"
      ],
      "enabled": false
    },
    {
      "description": "Disable github actions that are managed by python-copier-template",
      "matchPackageNames": [
        "actions/checkout",
        "astral-sh/setup-uv",
        "prefix-dev/setup-pixi",
        "snok/install-poetry",
        "actions/upload-artifact",
        "actions/download-artifact",
        "softprops/action-gh-release",
        "orhun/git-cliff-action",
        "codecov/codecov-action",
        "arduino/setup-task",
        "extractions/setup-just"{% if docker %},
        "docker/setup-buildx-action",
        "docker/login-action",
        "docker/build-push-action",
        "docker/metadata-action"{% endif %}{% if pypi %},
        "pypa/gh-action-pypi-publish"{% endif %}{% if docs %},
        "peaceiris/actions-gh-pages"{% endif %}{% if fair %},
        "fair-software/howfairis-github-action"{% endif %}
      ],
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "description": "Disable Dockerfile base images that are managed by python-copier-template",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "ubuntu",
        "ghcr.io/diamondlightsource/ubuntu-devcontainer"
      ],
      "enabled": false
    }
  ]
}
