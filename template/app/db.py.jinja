"""Async SQLAlchemy engine, session factory and declarative base.

The engine is created lazily at import time but connects to nothing until a
query runs, so importing the app modules is side-effect free (test_qa.py and
offline tests rely on this).
"""

from __future__ import annotations

from collections.abc import AsyncIterator

from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.ext.asyncio import async_sessionmaker
from sqlalchemy.ext.asyncio import create_async_engine
from sqlalchemy.orm import DeclarativeBase

from app.settings import get_settings

engine = create_async_engine(get_settings().database_url)
"""Module-level async engine; tests override DATABASE_URL before importing."""

SessionLocal = async_sessionmaker(engine, expire_on_commit=False)
"""Async session factory (keeps attributes usable after commit)."""


class Base(DeclarativeBase):
    """Declarative base for all ORM models."""


async def get_session() -> AsyncIterator[AsyncSession]:
    """FastAPI dependency yielding a database session."""
    async with SessionLocal() as session:
        yield session
