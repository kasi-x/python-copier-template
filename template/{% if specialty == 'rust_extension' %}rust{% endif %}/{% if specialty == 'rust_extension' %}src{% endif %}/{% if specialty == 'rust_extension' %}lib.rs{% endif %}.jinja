use pyo3::prelude::*;

/// A sample PyO3 function. Replace with your Rust core.
#[pyfunction]
fn add(a: i64, b: i64) -> i64 {
    a + b
}

/// {{ package_name }}_rs: Rust core bound to Python.
#[pymodule]
fn {{ package_name }}_rs(m: &Bound<'_, PyModule>) -> PyResult<()> {
    m.add_function(wrap_pyfunction!(add, m)?)?;
    Ok(())
}
