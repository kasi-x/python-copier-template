# Copy this file to `.env` and adjust the values to your environment:
#   cp .env.example .env
#
# `.env` is git-ignored and is loaded automatically by direnv (see .envrc)
# and by the docker compose files. Never commit real secrets.

# Sentry error tracking (only used when `include_sentry` was enabled)
# SENTRY_DSN=https://public_key@ingest.sentry.io/project_id

# LLM API key for the pydantic-ai agent scaffold (only used when the agent
# was enabled; the offline demo uses TestModel and needs no key).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
{% if mcp_effective %}
# MCP server over Streamable HTTP (only used when `include_mcp` was enabled).
# Comma-separated Host allowlist for the DNS-rebinding protection. REQUIRED
# when the server binds to a non-local address (--host 0.0.0.0, e.g. inside
# Docker); the SDK otherwise accepts any Host header, so mcp_server.py
# refuses to start without it.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=https://app.example.com
{% endif %}{% if bot_discord_effective %}
# Discord bot token (only used when the bot layer was enabled). REQUIRED:
# bot_discord.py refuses to start without it. Create an application at
# discord.com/developers/applications, add a bot, and copy its token here.
# Never commit the real token — `.env` stays out of git.
# DISCORD_BOT_TOKEN=
{% endif %}{% if bot_slack_effective %}
# Slack bot tokens (only used when the slack bot platform was enabled). BOTH
# are REQUIRED: bot_slack.py refuses to start without either. Create the app
# at api.slack.com/apps, enable Socket Mode, and copy the Bot User OAuth
# Token (xoxb-) and an app-level token with the connections:write scope
# (xapp-) here. Never commit the real tokens — `.env` stays out of git.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
{% endif %}{% if bot_line_effective %}
# LINE bot credentials (only used when the line bot platform was enabled).
# BOTH are REQUIRED: bot_line.py refuses to start without either. Create a
# Messaging API channel at developers.line.biz, issue a channel access token,
# and copy the channel secret and that token here. The secret verifies LINE's
# X-Line-Signature on every webhook POST — that check is what makes the public
# webhook URL safe. Never commit the real values — `.env` stays out of git.
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# Port the webhook listens on, on all interfaces (8000 by default).
# BOT_PORT=8000
{% endif %}{% if bot_gmail_effective %}
# Gmail bot credentials (only used when the gmail bot platform was enabled).
# BOTH are REQUIRED paths: bot_gmail.py refuses to start without either.
# Download the OAuth client (Desktop app) from Google Cloud Console
# (APIs & Services → Credentials) as credentials.json; token.json is written
# there by the first consent and refreshed on every later run. The token file
# IS the inbox — both stay git-ignored, never commit them.
# GMAIL_CREDENTIALS_JSON=credentials.json
# GMAIL_TOKEN_JSON=token.json
# Seconds between INBOX polls (60 by default).
# GMAIL_POLL_SECONDS=60
{% endif %}
{% if scraping_effective %}# Contact address embedded in the fetcher User-Agent so site operators can
# reach you (the Good-future charter requires a reachable contact before any
# real crawl; tests use the placeholder and never read this).
# FETCHER_CONTACT=you@example.com
{% endif %}
{% if web_api %}# Database connection used by the web API at runtime.
# The docker compose stack (compose.local.yml) exposes postgres on localhost:5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{ repo_name | replace('-', '_') }}

# Host/port the API listens on (uvicorn). The Dockerfile and compose both
# default to 0.0.0.0:8000; override here only if you need something else.
# HOST=0.0.0.0
# PORT=8000
{% if cors_effective %}# Comma-separated list of origins allowed to call the API from browsers.
# Leave empty (the default) to allow no cross-origin requests.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
{% endif %}{% endif %}# Any other environment-specific variables go here.
