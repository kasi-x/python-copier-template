"""Application settings, read from the environment / .env.

The pydantic-settings BaseSettings reads `APP_`-prefixed variables first,
then the bare names, then `.env`. The docker compose stack and CI both
inject `DATABASE_URL`; for local runs the `.env.example` default (points at
the compose Postgres) applies.
"""

from __future__ import annotations

from functools import lru_cache
from typing import ClassVar

from pydantic import field_validator
from pydantic_settings import BaseSettings
from pydantic_settings import SettingsConfigDict


class Settings(BaseSettings):
    """Runtime configuration for the web API."""

    model_config: ClassVar[SettingsConfigDict] = SettingsConfigDict(
        env_file=".env",
        extra="ignore",
    )

    database_url: str = (
        "postgresql+asyncpg://postgres:postgres@localhost:5432/"
        "{{ repo_name | replace('-', '_') }}"
    )
    """SQLAlchemy async database URL (postgresql+asyncpg:// or sqlite+aiosqlite://)."""

    host: str = "0.0.0.0"  # noqa: S104 - the API binds all interfaces inside Docker
    """Address uvicorn binds to (override with HOST)."""

    port: int = 8000
    """Port uvicorn listens on (override with PORT)."""

    cors_origins: list[str] = []
    """Allowed CORS origins; set CORS_ORIGINS to a comma-separated list."""

    @field_validator("cors_origins", mode="before")
    @classmethod
    def _split_cors_origins(cls, value: object) -> object:
        if isinstance(value, str):
            return [origin.strip() for origin in value.split(",") if origin.strip()]
        return value


@lru_cache
def get_settings() -> Settings:
    """Return a cached Settings instance (pydantic reads .env once)."""
    return Settings()
