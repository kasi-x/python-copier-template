"""Prometheus metrics middleware (prometheus-client, no extra framework glue).

A thin ASGI/HTTP middleware that counts requests by method and route and
exposes the metrics at /metrics. This deliberately avoids
prometheus-fastapi-instrumentator, which has repeatedly lagged FastAPI's
routing internals; ~20 lines of prometheus-client keeps the scaffold working
across FastAPI/Starlette versions.
"""

from __future__ import annotations

from collections.abc import Awaitable
from collections.abc import Callable

from prometheus_client import CONTENT_TYPE_LATEST
from prometheus_client import Counter
from prometheus_client import generate_latest
from starlette.requests import Request
from starlette.responses import Response

REQUESTS = Counter(
    "http_requests_total",
    "Total HTTP requests",
    ["method", "path"],
)

__all__ = ["REQUESTS", "metrics_endpoint", "prometheus_middleware"]


async def metrics_endpoint(request: Request) -> Response:  # noqa: ARG001 - FastAPI route signature
    """Serve the metrics in Prometheus text format."""
    return Response(
        content=generate_latest(),
        media_type=CONTENT_TYPE_LATEST,
    )


async def prometheus_middleware(
    request: Request,
    call_next: Callable[[Request], Awaitable[Response]],
) -> Response:
    """Count every request by method and route path."""
    route = request.scope.get("route")
    path = getattr(route, "path", request.url.path)
    REQUESTS.labels(method=request.method, path=path).inc()
    return await call_next(request)
