import json
{%- if log_library == 'logging' %}
import logging
{%- endif %}
import os
import sys
from datetime import UTC
from datetime import datetime
{%- if log_library == 'picologging' %}

import picologging as logging
{%- endif %}

_std_logger = logging.getLogger("{{ package_name }}")
_fmt = "console"
_configured = False


def setup_logging(format_: str | None = None, level: str = "INFO") -> None:
    """{% if allow_japanese %}プロセス起動時に一度だけ呼ぶ。既に設定済みなら何もしない。{% else %}Call once at startup; a no-op if already configured.{% endif %}"""
    global _configured, _fmt
    if _configured:
        return

    _fmt = (format_ or os.environ.get("LOG_FORMAT") or "console").lower()
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(logging.Formatter("%(message)s"))
    _std_logger.handlers = [handler]
    _std_logger.setLevel(getattr(logging, level.upper(), logging.INFO))
    _std_logger.propagate = False
    _configured = True


class BoundLogger:
    """{% if allow_japanese %}structlog 風の `event, **kv` 呼び出しを標準 logging の API にアダプトする薄いラッパー。{% else %}Thin wrapper adapting the standard library logging API to a structlog-style `event, **kv` call shape.{% endif %}"""

    def __init__(self, **bound: object) -> None:
        self._bound: dict[str, object] = bound

    def bind(self, **kv: object) -> BoundLogger:
        return BoundLogger(**{**self._bound, **kv})

    def _emit(self, level: str, event: str, kv: dict[str, object]) -> None:
        fields = {**self._bound, **kv}
        if _fmt == "json":
            payload = {"timestamp": datetime.now(UTC).isoformat(), "level": level, "event": event, **fields}
            message = json.dumps(payload, default=str, ensure_ascii=False)
        else:
            extra = "" if not fields else " " + " ".join(f"{k}={v!r}" for k, v in fields.items())
            message = f"{event}{extra}"
        getattr(_std_logger, level)(message)

    def debug(self, event: str, **kv: object) -> None:
        self._emit("debug", event, kv)

    def info(self, event: str, **kv: object) -> None:
        self._emit("info", event, kv)

    def warning(self, event: str, **kv: object) -> None:
        self._emit("warning", event, kv)

    def error(self, event: str, **kv: object) -> None:
        self._emit("error", event, kv)

    def exception(self, event: str, **kv: object) -> None:
        self._emit("exception", event, kv)


def get_logger(name: str | None = None) -> BoundLogger:
    """{% if allow_japanese %}設定を行い、bound logger を返す。{% else %}Configure logging and return a bound logger.{% endif %}"""
    setup_logging()
    return BoundLogger(logger=name) if name else BoundLogger()


# Module-level logger: `from {{ package_name }}.logging_setup import logger`
logger = get_logger()
