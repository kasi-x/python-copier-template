from __future__ import annotations
{% if log_library == 'structlog' %}
import logging
import os
import sys

import structlog

_configured = False


def setup_logging(format_: str | None = None, level: str = "INFO") -> None:
    """{% if allow_japanese %}プロセス起動時に一度だけ呼ぶ。既に設定済みなら何もしない。{% else %}Call once at startup; a no-op if already configured.{% endif %}"""
    global _configured
    if _configured:
        return

    fmt = (format_ or os.environ.get("LOG_FORMAT") or "console").lower()
    processors: list[structlog.typing.Processor] = [
        structlog.contextvars.merge_contextvars,
        structlog.processors.add_log_level,
        structlog.processors.TimeStamper(fmt="iso", utc=True),
    ]
    if fmt == "json":
        processors.append(structlog.processors.JSONRenderer(ensure_ascii=False))
    else:
        processors.append(structlog.processors.StackInfoRenderer())
        processors.append(structlog.dev.ConsoleRenderer(colors=fmt == "dev" and _stdout_is_tty()))

    structlog.configure(
        processors=processors,
        wrapper_class=structlog.make_filtering_bound_logger(int(getattr(logging, level.upper(), logging.INFO))),
        logger_factory=structlog.PrintLoggerFactory(file=sys.stderr),
        cache_logger_on_first_use=True,
    )
    _configured = True


def _stdout_is_tty() -> bool:
    try:
        return bool(os.isatty(1))
    except Exception:  # noqa: BLE001
        return False


def get_logger(name: str | None = None) -> structlog.stdlib.BoundLogger:
    """{% if allow_japanese %}設定を行い、bound logger を返す。{% else %}Configure logging and return a bound logger.{% endif %}"""
    setup_logging()
    return structlog.stdlib.get_logger(name)


# Module-level logger: `from {{ package_name }}.logging_setup import logger`
logger = get_logger()
{% elif log_library == 'loguru' %}
import os
import sys
from typing import TYPE_CHECKING

from loguru import logger as _logger

if TYPE_CHECKING:
    from loguru import Logger

_configured = False


def setup_logging(format_: str | None = None, level: str = "INFO") -> None:
    """{% if allow_japanese %}プロセス起動時に一度だけ呼ぶ。既に設定済みなら何もしない。{% else %}Call once at startup; a no-op if already configured.{% endif %}"""
    global _configured
    if _configured:
        return

    fmt = (format_ or os.environ.get("LOG_FORMAT") or "console").lower()
    _logger.remove()
    if fmt == "json":
        _logger.add(sys.stderr, level=level, serialize=True)
    else:
        _logger.add(
            sys.stderr,
            level=level,
            colorize=fmt == "dev" and _stdout_is_tty(),
            format="<green>{time:YYYY-MM-DD HH:mm:ss}</green> <level>{level: <8}</level> {message} <dim>{extra}</dim>",
        )
    _configured = True


def _stdout_is_tty() -> bool:
    try:
        return bool(os.isatty(1))
    except Exception:  # noqa: BLE001
        return False


class BoundLogger:
    """{% if allow_japanese %}structlog 風の `event, **kv` 呼び出しを loguru の bind API にアダプトする薄いラッパー。{% else %}Thin wrapper adapting loguru's bind API to a structlog-style `event, **kv` call shape.{% endif %}"""

    def __init__(self, **bound: object) -> None:
        self._bound: dict[str, object] = bound

    def bind(self, **kv: object) -> BoundLogger:
        return BoundLogger(**{**self._bound, **kv})

    def _emit(self, level: str, event: str, kv: dict[str, object]) -> None:
        fields = {**self._bound, **kv}
        target: Logger = _logger.bind(**fields) if fields else _logger
        getattr(target, level)(event)

    def debug(self, event: str, **kv: object) -> None:
        self._emit("debug", event, kv)

    def info(self, event: str, **kv: object) -> None:
        self._emit("info", event, kv)

    def warning(self, event: str, **kv: object) -> None:
        self._emit("warning", event, kv)

    def error(self, event: str, **kv: object) -> None:
        self._emit("error", event, kv)

    def exception(self, event: str, **kv: object) -> None:
        self._emit("exception", event, kv)


def get_logger(name: str | None = None) -> BoundLogger:
    """{% if allow_japanese %}設定を行い、bound logger を返す。{% else %}Configure logging and return a bound logger.{% endif %}"""
    setup_logging()
    return BoundLogger(logger=name) if name else BoundLogger()


