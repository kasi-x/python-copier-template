# ROS 2 development + runtime image for {{ repo_name }}.
#
# Build:  docker build -f Dockerfile.ros2 -t {{ repo_name }} .
# Run:    docker run --rm {{ repo_name }} ros2 run {{ repo_name }} {{ repo_name }}

{% if ros2_package_manager == 'pixi' %}
# pixi (RoboStack) flavour: install pixi, let it create the ROS environment
# from pixi.toml (robostack-{{ ros_distro }} channel), then build the
# workspace inside it.
FROM ubuntu:{{ '22.04' if ros_distro == 'humble' else '24.04' }} AS developer

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    ccache \
    && rm -rf /var/lib/apt/lists/*

# Install pixi
RUN curl -fsSL https://pixi.sh/install.sh | bash
ENV PATH="/root/.pixi/bin:${PATH}"

WORKDIR /workspace
COPY . src/{{ repo_name }}

# Create the pixi environment (ros-{{ ros_distro }}-* from robostack).
RUN pixi install --locked

# Build the workspace inside the pixi environment.
RUN pixi run colcon build --symlink-install --packages-select {{ package_name }}

FROM developer AS runtime

# pixi environments are activated per-command; `pixi run` handles sourcing.
ENTRYPOINT ["pixi", "run"]
CMD ["ros2", "run", "{{ repo_name }}", "{{ repo_name }}"]
{% else %}
# apt (colcon + rosdep) flavour: the classic ROS 2 image.
FROM ros:{{ ros_distro }}-ros-base AS developer

# Install build tools and the package's rosdep dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    ccache \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . src/{{ repo_name }}

# Resolve dependencies from package.xml, then build the workspace.
RUN rosdep update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && . /opt/ros/$ROS_DISTRO/setup.sh \
    && colcon build --symlink-install --packages-select {{ package_name }}

# Source the workspace on entry so `ros2 run` finds the package.
RUN echo "source /workspace/install/setup.bash" >> /ros_entrypoint.sh

FROM developer AS runtime

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["ros2", "run", "{{ repo_name }}", "{{ repo_name }}"]
{% endif %}
