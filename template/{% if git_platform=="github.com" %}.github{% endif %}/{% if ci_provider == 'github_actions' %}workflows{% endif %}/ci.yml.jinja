name: CI
{% raw %}
permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

on:
  push:
    branches:
      - main
    tags:
      - '*'
  pull_request:
{% endraw %}
jobs:
{% if ros2_pkg %}{% if ros2_package_manager == 'pixi' %}
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7
      - name: Install pixi
        uses: prefix-dev/setup-pixi@v0.10.1
        with:
          environments: default
      - name: Build the workspace
        run: pixi run colcon build --symlink-install --packages-select {{ package_name }}
      - name: Run the ament test suite
        run: |
          pixi run colcon test --packages-select {{ package_name }}
          pixi run colcon test-result --verbose
{% else %}
  industrial_ci:
    strategy:
      fail-fast: false
      matrix:
        env:
          - ROS_DISTRO: {{ ros_distro }}
    env:
      ROS_DISTRO: {{ ros_distro }}
      ROS_REPO: main
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7
      - name: Run industrial_ci
        uses: ros-industrial/industrial_ci@master
{% raw %}        env:
          ROS_DISTRO: ${{ matrix.env.ROS_DISTRO }}
{% endraw %}{% endif %}{% else %}
  lint:
    uses: ./.github/workflows/_tasks.yml
    with:
      task_runner: {{ task_runner_effective }}
      task: lint{{ ",type-check" if strictness in ['recommended', 'full'] else "" }}
{% raw %}
  test:
    strategy:
      matrix:
        runs-on: ["ubuntu-latest"] # can add windows-latest, macos-latest
{% endraw %}
        python-version: {{ '["3.11", "3.12", "3.13", "3.14"]' if package_manager == "uv" else '["3.11"]' }}
{% raw %}
      fail-fast: false
{% endraw %}
{% if project_type == 'web_api' and not docker %}
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{% endif %}
{% raw %}
    uses: ./.github/workflows/_test.yml
    with:
      runs-on: ${{ matrix.runs-on }}
      python-version: ${{ matrix.python-version }}
{% endraw %}      task_runner: {{ task_runner_effective }}
{% if project_type == 'web_api' and not docker %}
      postgres-host: localhost
      postgres-port: 5432
      postgres-user: postgres
      postgres-password: postgres
      postgres-db: test
{% endif %}
{% if docker %}{% raw %}
  container:
    needs: test
    if: always()
    uses: ./.github/workflows/_container.yml
    with:
      publish: ${{ needs.test.result == 'success' }}
    permissions:
      contents: read
      packages: write
{% endraw %}{% endif %}{% if docs %}
  docs:
    uses: ./.github/workflows/_docs.yml
    with:
      task_runner: {{ task_runner_effective }}
    permissions:
      contents: write
{% endif %}
{% if micropython_pkg %}
  firmware:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7
      - name: Build frozen firmware
        run: python3 tools/micropython/freeze.py
      - name: Upload firmware
        uses: actions/upload-artifact@v8
        with:
          name: firmware-{{ micropython_port }}
          path: dist/
  release:
    needs: [firmware]
    if: github.ref_type == 'tag'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Download firmware
        uses: actions/download-artifact@v8
        with:
          name: firmware-{{ micropython_port }}
          path: dist
      - uses: softprops/action-gh-release@3d0d9888cb7fd7b750713d6e236d1fcb99157228 # v3.0.2
        with:
          files: dist/**
          generate_release_notes: true
{% elif not micropython_pkg %}
  dist:
    uses: ./.github/workflows/_dist.yml
  {% if pypi %}
  pypi:
    needs: [dist, test]
    if: github.ref_type == 'tag'
    uses: ./.github/workflows/_pypi.yml
    permissions:
      id-token: write
  {% endif %}
  release:
    needs: [dist, test{% if docs %}, docs{% endif %}]
    if: github.ref_type == 'tag'
    uses: ./.github/workflows/_release.yml
    permissions:
      contents: write
{% endif %}
  required-checks-passed:
    name: all required checks passed
    needs: [lint, test{% if docker %}, container{% endif %}{% if docs %}, docs{% endif %}{% if micropython_pkg %}, firmware{% elif not micropython_pkg %}, dist{% endif %}]
{% raw %}
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Check all required jobs passed
        run: |
          failing=$(echo '${{ toJSON(needs) }}' | jq -r '
            to_entries[] |
            select(.value.result != "success" and .value.result != "skipped") |
            "\(.key): \(.value.result)"
          ')
          if [ -n "$failing" ]; then
            echo "$failing"
            exit 1
          fi
{% endraw -%}{% endif -%}
