# MicroPython type stubs — installed into typings/ (NOT the venv) so they
# do not shadow CPython's stdlib during host-side type checking.
#
#   uv run pip install -r requirements-dev.txt --target typings
#
# The package version is aligned to the MicroPython firmware version; pin
# it (e.g. micropython-{{ micropython_port }}-stubs~=1.23.0) when you target
# a specific firmware release.
micropython-{{ micropython_port }}-stubs
