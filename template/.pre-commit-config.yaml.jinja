default_install_hook_types: [pre-commit, commit-msg]

repos:
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.4.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]

  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-added-large-files
        exclude: ^(uv|pixi)\.lock
      - id: check-yaml
      - id: check-merge-conflict
      - id: end-of-file-fixer
        # uv/pixi lockfiles are machine-generated and may not end in a newline
        exclude: ^(uv|pixi)\.lock$

  - repo: local
    hooks:
      - id: ruff
        name: lint with ruff
        language: system
        entry: ruff check --force-exclude --fix
        types: [python]
        require_serial: true

      - id: ruff-format
        name: format with ruff
        language: system
        entry: ruff format --force-exclude
        types: [python]
        require_serial: true

{% if ros2_pkg and ros2_package_manager == 'pixi' %}
      - id: lock-sync
        name: sync lockfile and environment
        pass_filenames: false
        language: system
        entry: bash -c 'if [ -f pixi.lock ]; then pixi install --locked; fi'
        files: ^(pixi\.lock|pixi\.toml)$
{% else %}
      - id: lock-sync
        name: sync lockfile and environment
        pass_filenames: false
        language: system
        entry: bash -c 'if [ -f pixi.lock ]; then pixi install; elif [ -f poetry.lock ]; then poetry install --sync; else uv sync; fi'
        files: ^(uv\.lock|pixi\.lock|poetry\.lock|pyproject\.toml)$
{% endif %}

{% if strictness in ['recommended', 'full'] %}
  - repo: https://github.com/crate-ci/typos
    rev: v1.49.0
    hooks:
      - id: typos
        args: [--force-exclude]

  - repo: https://github.com/fpgmaas/deptry
    rev: "0.25.1"
    hooks:
      - id: deptry

{% endif %}
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks

  - repo: https://github.com/kynan/nbstripout
    rev: 0.8.1
    hooks:
      - id: nbstripout
        name: nbstripout
        description: "nbstripout: strip output from Jupyter and IPython notebooks"
        entry: nbstripout
        language: python
        types: [jupyter]

  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.12
    hooks:
      - id: actionlint
        language: golang
        additional_dependencies:
          - "github.com/wasilibs/go-shellcheck/cmd/shellcheck@v0.11.1"

  - repo: https://github.com/zizmorcore/zizmor-pre-commit
    rev: v1.29.0
    hooks:
      - id: zizmor
{% if fair %}
  - repo: https://github.com/citation-file-format/cff-converter-python
    rev: 054bda51dbe278b3e86f27c890e3f3ac877d616c
    hooks:
      - id: validate-cff
{% endif %}{% if reuse_effective %}
  - repo: https://github.com/fsfe/reuse-tool
    rev: v6.2.0
    hooks:
      - id: reuse
{% endif -%}
