"""Wire-up for the {{ repo_name }} MicroPython firmware.

MicroPython executes ``/main.py`` on boot, so this file must live at the
device root. Keep it as a thin hardware wiring layer: the device-independent
logic lives in ``core/`` (importable and unit-testable under CPython), and
the board-specific pins live in ``board_config.py``.

``machine`` is imported lazily so the same file also runs on ports without
hardware (unix/windows), where the frozen firmware prints instead of
blinking.
"""

import time

from board_config import LED_PIN


def run_hardware_blink() -> None:
    """Blink the on-board LED on a real device port."""
    from machine import Pin  # noqa: PLC0415 - lazy so unix/windows ports run too
    from core.app import BlinkConfig  # noqa: PLC0415
    from core.app import Clock  # noqa: PLC0415
    from core.app import run  # noqa: PLC0415

    class Led:
        """DigitalOut backed by a ``machine.Pin`` in output mode."""

        def __init__(self, pin: int | str) -> None:
            self._pin = Pin(pin, Pin.OUT)

        def on(self) -> None:
            self._pin.on()

        def off(self) -> None:
            self._pin.off()

    class SysClock:
        """Clock adapter around the MicroPython ``time`` module.

        MicroPython's ``time.sleep`` takes a positional-only argument, which
        does not satisfy the ``Clock`` protocol directly, so wrap it.
        """

        def sleep(self, seconds: float) -> None:
            time.sleep(seconds)

    run(led=Led(LED_PIN), clock=SysClock(), config=BlinkConfig())


def main() -> None:
    if LED_PIN is None:
        # No on-board LED on this port (e.g. the unix/windows ports) —
        # print instead of blinking.
        while True:
            print("{{ repo_name }} running (no LED on this port)")
            time.sleep(1.0)
    else:
        run_hardware_blink()


main()
