"""Wire-up for the {{ repo_name }} MicroPython firmware.

MicroPython executes ``/main.py`` on boot, so this file must live at the
device root. Keep it as a thin hardware wiring layer: the device-independent
logic lives in ``core/`` (importable and unit-testable under CPython), and
the board-specific pins live in ``board_config.py``.
"""

import time

from machine import Pin

from board_config import LED_PIN
from core.app import BlinkConfig
from core.app import Clock
from core.app import run


class Led:
    """DigitalOut backed by a ``machine.Pin`` in output mode."""

    def __init__(self, pin: int | str) -> None:
        self._pin = Pin(pin, Pin.OUT)

    def on(self) -> None:
        self._pin.on()

    def off(self) -> None:
        self._pin.off()


class SysClock:
    """Clock adapter around the MicroPython ``time`` module.

    MicroPython's ``time.sleep`` takes a positional-only argument, which does
    not satisfy the ``Clock`` protocol directly, so wrap it.
    """

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)


def main() -> None:
    if LED_PIN is None:
        # No on-board LED on this port (e.g. the unix/windows ports) —
        # print instead of blinking.
        while True:
            print("{{ repo_name }} running (no LED on this port)")
            time.sleep(1.0)
    else:
        run(led=Led(LED_PIN), clock=SysClock(), config=BlinkConfig())


main()
