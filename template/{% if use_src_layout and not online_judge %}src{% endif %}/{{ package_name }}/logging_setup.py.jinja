{% if allow_japanese %}"""ロギング設定 ({{ log_library }})。

既定は人間向けの開発表示、`LOG_FORMAT=json` で cron / systemd / 集約ログ向けの
JSON に切り替えられる。

    from {{ package_name }}.logging_setup import logger

    logger = logger.bind(task_id="T-123")
    logger.info("job_done", chunks=3)
"""
{% else %}"""Logging setup ({{ log_library }}).

The default is a human-readable console output; set `LOG_FORMAT=json` for
JSON logs suitable for cron / systemd / log aggregation.

    from {{ package_name }}.logging_setup import logger

    logger = logger.bind(task_id="T-123")
    logger.info("job_done", chunks=3)
"""
{% endif %}
from __future__ import annotations
{% if log_library == 'structlog' %}
import logging
import os
import sys
{%- if cloud_provider == 'gcp' %}
from typing import cast
{%- endif %}

import structlog

_configured = False
{%- if cloud_provider == 'gcp' %}
# Field names/values Cloud Logging's structured-log parser recognises:
# https://cloud.google.com/logging/docs/structured-logging
# https://cloud.google.com/logging/docs/reference/v2/rest/v2/LogEntry#LogSeverity
_GCP_SEVERITY = {"debug": "DEBUG", "info": "INFO", "warning": "WARNING", "error": "ERROR", "exception": "ERROR"}
{%- endif %}


def setup_logging(format_: str | None = None, level: str = "INFO") -> None:
    """{% if allow_japanese %}プロセス起動時に一度だけ呼ぶ。既に設定済みなら何もしない。{% else %}Call once at startup; a no-op if already configured.{% endif %}"""
    global _configured
    if _configured:
        return

    fmt = (format_ or os.environ.get("LOG_FORMAT") or "console").lower()
    processors: list[structlog.typing.Processor] = [
        structlog.contextvars.merge_contextvars,
        structlog.processors.add_log_level,
        structlog.processors.TimeStamper(fmt="iso", utc=True),
    ]
    if fmt == "json":
        {%- if cloud_provider == 'gcp' %}
        processors.append(_gcp_fields)
        {%- endif %}
        processors.append(structlog.processors.JSONRenderer(ensure_ascii=False))
    else:
        processors.append(structlog.processors.StackInfoRenderer())
        processors.append(structlog.dev.ConsoleRenderer(colors=fmt == "dev" and _stdout_is_tty()))

    structlog.configure(
        processors=processors,
        wrapper_class=structlog.make_filtering_bound_logger(int(getattr(logging, level.upper(), logging.INFO))),
        logger_factory=structlog.PrintLoggerFactory(file=sys.stderr),
        cache_logger_on_first_use=True,
    )
    _configured = True


def _stdout_is_tty() -> bool:
    try:
        return bool(os.isatty(1))
    except Exception:  # noqa: BLE001
        return False

{% if cloud_provider == 'gcp' %}

def _gcp_fields(_: object, __: str, event_dict: structlog.typing.EventDict) -> structlog.typing.EventDict:
    """{% if allow_japanese %}Cloud Logging が特別扱いする severity/message/time フィールド名にリネームする。
    https://cloud.google.com/logging/docs/structured-logging
    {% else %}Rename fields to what Cloud Logging's structured-log parser
    recognises (severity/message/time).
    https://cloud.google.com/logging/docs/structured-logging
    {% endif %}"""
    level_name = cast("str", event_dict.pop("level", "info"))
    event_dict["severity"] = _GCP_SEVERITY.get(level_name, level_name.upper())
    event_dict["message"] = event_dict.pop("event", "")
    if "timestamp" in event_dict:
        event_dict["time"] = event_dict.pop("timestamp")
    return event_dict
{% endif %}

def get_logger(name: str | None = None) -> structlog.stdlib.BoundLogger:
    """{% if allow_japanese %}設定を行い、bound logger を返す。{% else %}Configure logging and return a bound logger.{% endif %}"""
    setup_logging()
    return structlog.stdlib.get_logger(name)


# Module-level logger: `from {{ package_name }}.logging_setup import logger`
logger = get_logger()
{% elif log_library == 'loguru' %}
{%- if cloud_provider == 'gcp' %}
import json
{%- endif %}
import os
import sys
from typing import TYPE_CHECKING

from loguru import logger as _logger

if TYPE_CHECKING:
    from loguru import Logger
    {%- if cloud_provider == 'gcp' %}
    from loguru import Message
    {%- endif %}

_configured = False


def setup_logging(format_: str | None = None, level: str = "INFO") -> None:
    """{% if allow_japanese %}プロセス起動時に一度だけ呼ぶ。既に設定済みなら何もしない。{% else %}Call once at startup; a no-op if already configured.{% endif %}"""
    global _configured
    if _configured:
        return

    fmt = (format_ or os.environ.get("LOG_FORMAT") or "console").lower()
    _logger.remove()
    if fmt == "json":
        {%- if cloud_provider == 'gcp' %}
        _logger.add(_gcp_sink, level=level)
        {%- else %}
        _logger.add(sys.stderr, level=level, serialize=True)
        {%- endif %}
    else:
        _logger.add(
            sys.stderr,
            level=level,
            colorize=fmt == "dev" and _stdout_is_tty(),
            format="<green>{time:YYYY-MM-DD HH:mm:ss}</green> <level>{level: <8}</level> {message} <dim>{extra}</dim>",
        )
    _configured = True


def _stdout_is_tty() -> bool:
    try:
        return bool(os.isatty(1))
    except Exception:  # noqa: BLE001
        return False

{% if cloud_provider == 'gcp' %}

def _gcp_sink(message: Message) -> None:
    """{% if allow_japanese %}Cloud Logging が特別扱いする severity/message/time フィールド名で1行JSONを書く。
    https://cloud.google.com/logging/docs/structured-logging
    {% else %}Write one JSON line using the field names Cloud Logging's
    structured-log parser recognises (severity/message/time).
    https://cloud.google.com/logging/docs/structured-logging
    {% endif %}"""
    record = message.record
    payload = {
        "time": record["time"].isoformat(),
        "severity": record["level"].name,
        "message": record["message"],
        **record["extra"],
    }
    sys.stderr.write(json.dumps(payload, default=str, ensure_ascii=False) + "\n")
{% endif %}

class BoundLogger:
    """{% if allow_japanese %}structlog 風の `event, **kv` 呼び出しを loguru の bind API にアダプトする薄いラッパー。{% else %}Thin wrapper adapting loguru's bind API to a structlog-style `event, **kv` call shape.{% endif %}"""

    def __init__(self, **bound: object) -> None:
        self._bound: dict[str, object] = bound

    def bind(self, **kv: object) -> BoundLogger:
        return BoundLogger(**{**self._bound, **kv})

    def _emit(self, level: str, event: str, kv: dict[str, object]) -> None:
        fields = {**self._bound, **kv}
        target: Logger = _logger.bind(**fields) if fields else _logger
        getattr(target, level)(event)

    def debug(self, event: str, **kv: object) -> None:
        self._emit("debug", event, kv)

    def info(self, event: str, **kv: object) -> None:
        self._emit("info", event, kv)

    def warning(self, event: str, **kv: object) -> None:
        self._emit("warning", event, kv)

    def error(self, event: str, **kv: object) -> None:
        self._emit("error", event, kv)

    def exception(self, event: str, **kv: object) -> None:
        self._emit("exception", event, kv)


def get_logger(name: str | None = None) -> BoundLogger:
    """{% if allow_japanese %}設定を行い、bound logger を返す。{% else %}Configure logging and return a bound logger.{% endif %}"""
    setup_logging()
    return BoundLogger(logger=name) if name else BoundLogger()


# Module-level logger: `from {{ package_name }}.logging_setup import logger`
logger = get_logger()
{% else %}
import json
{%- if log_library == 'logging' %}
import logging
{%- endif %}
import os
import sys
from datetime import UTC
from datetime import datetime
{%- if log_library == 'picologging' %}

import picologging as logging
{%- endif %}

_std_logger = logging.getLogger("{{ package_name }}")
_fmt = "console"
_configured = False
{%- if cloud_provider == 'gcp' %}
# Field names/values Cloud Logging's structured-log parser recognises:
# https://cloud.google.com/logging/docs/structured-logging
# https://cloud.google.com/logging/docs/reference/v2/rest/v2/LogEntry#LogSeverity
_GCP_SEVERITY = {"debug": "DEBUG", "info": "INFO", "warning": "WARNING", "error": "ERROR", "exception": "ERROR"}
{%- endif %}


def setup_logging(format_: str | None = None, level: str = "INFO") -> None:
    """{% if allow_japanese %}プロセス起動時に一度だけ呼ぶ。既に設定済みなら何もしない。{% else %}Call once at startup; a no-op if already configured.{% endif %}"""
    global _configured, _fmt
    if _configured:
        return

    _fmt = (format_ or os.environ.get("LOG_FORMAT") or "console").lower()
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(logging.Formatter("%(message)s"))
    _std_logger.handlers = [handler]
    _std_logger.setLevel(getattr(logging, level.upper(), logging.INFO))
    _std_logger.propagate = False
    _configured = True


class BoundLogger:
    """{% if allow_japanese %}structlog 風の `event, **kv` 呼び出しを標準 logging の API にアダプトする薄いラッパー。{% else %}Thin wrapper adapting the standard library logging API to a structlog-style `event, **kv` call shape.{% endif %}"""

    def __init__(self, **bound: object) -> None:
        self._bound: dict[str, object] = bound

    def bind(self, **kv: object) -> BoundLogger:
        return BoundLogger(**{**self._bound, **kv})

    def _emit(self, level: str, event: str, kv: dict[str, object]) -> None:
        fields = {**self._bound, **kv}
        if _fmt == "json":
            {%- if cloud_provider == 'gcp' %}
            payload = {
                "time": datetime.now(UTC).isoformat(),
                "severity": _GCP_SEVERITY.get(level, level.upper()),
                "message": event,
                **fields,
            }
            {%- else %}
            payload = {"timestamp": datetime.now(UTC).isoformat(), "level": level, "event": event, **fields}
            {%- endif %}
            message = json.dumps(payload, default=str, ensure_ascii=False)
        else:
            extra = "" if not fields else " " + " ".join(f"{k}={v!r}" for k, v in fields.items())
            message = f"{event}{extra}"
        getattr(_std_logger, level)(message)

    def debug(self, event: str, **kv: object) -> None:
        self._emit("debug", event, kv)

    def info(self, event: str, **kv: object) -> None:
        self._emit("info", event, kv)

    def warning(self, event: str, **kv: object) -> None:
        self._emit("warning", event, kv)

    def error(self, event: str, **kv: object) -> None:
        self._emit("error", event, kv)

    def exception(self, event: str, **kv: object) -> None:
        self._emit("exception", event, kv)


def get_logger(name: str | None = None) -> BoundLogger:
    """{% if allow_japanese %}設定を行い、bound logger を返す。{% else %}Configure logging and return a bound logger.{% endif %}"""
    setup_logging()
    return BoundLogger(logger=name) if name else BoundLogger()


# Module-level logger: `from {{ package_name }}.logging_setup import logger`
logger = get_logger()
{% endif -%}
