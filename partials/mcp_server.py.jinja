"""MCP (Model Context Protocol) server for {{ package_name }}.

Run it over stdio (the default; how an MCP host launches this server):

    uv run mcp-server-{{ repo_name }}

Or serve it over HTTP (Streamable HTTP):

    uv run python -m {{ import_pkg }}.mcp_server --transport streamable-http

Debug interactively with the MCP Inspector (requires npx):

    uv run mcp dev {{ pkg_dir }}/mcp_server.py

Binding to a non-local address (--host 0.0.0.0, e.g. inside Docker) requires
the MCP_ALLOWED_HOSTS environment variable: the SDK arms its DNS-rebinding
protection only while the server binds to localhost, so without an explicit
allowlist a publicly bound server would accept any Host header. The scaffold
refuses to start in that state. Health checks (unauthenticated, for
orchestrators) live at GET /health.

The in-process client test (tests/test_mcp_server.py) shows how to call
these tools, resources and prompts with the SDK's Client — the same pattern
a real MCP client uses.
"""

from __future__ import annotations

import argparse
import os
from collections.abc import Sequence
from typing import Literal
from typing import cast

from mcp.server import MCPServer
from mcp.server.mcpserver.exceptions import ToolError
from mcp.server.transport_security import TransportSecuritySettings
from starlette.requests import Request
from starlette.responses import JSONResponse

server = MCPServer("{{ repo_name }}")

__all__ = ["main", "server"]


@server.tool()
def add(a: int, b: int) -> int:
    """Add two integers and return the sum."""
    return a + b


@server.tool()
def divide(numerator: float, denominator: float) -> float:
    """Divide numerator by denominator."""
    if denominator == 0:
        raise ToolError("division by zero")
    return numerator / denominator


@server.resource("project://about")
def about() -> str:
    """Describe this server as an MCP resource."""
    return "MCP server for {{ repo_name }}."


@server.resource("greeting://{name}")
def greeting(name: str) -> str:
    """Resource template: URI parameters map to function arguments."""
    return f"Hello, {name}! Welcome to {{ repo_name }}."


@server.prompt(title="Review code")
def review_code(code: str) -> str:
    """Ask the model to review a piece of code for correctness and clarity."""
    return (
        "Please review the following code for correctness, clarity, "
        f"and potential bugs:\n\n{code}"
    )


@server.custom_route("/health", methods=["GET"])
async def health(_request: Request) -> JSONResponse:
    """Liveness probe for Docker / load balancers (unauthenticated)."""
    return JSONResponse({"status": "ok"})


def _allowed_hosts() -> TransportSecuritySettings | None:
    """Build transport security from MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS.

    The SDK arms DNS-rebinding protection only while the server binds to
    localhost; binding anywhere else leaves every Host header accepted unless
    an allowlist is supplied. main() enforces the variable for non-local
    binds; this helper turns it into the SDK's settings object.
    """
    raw_hosts = os.environ.get("MCP_ALLOWED_HOSTS")
    if not raw_hosts:
        return None
    allowed_hosts = [host.strip() for host in raw_hosts.split(",") if host.strip()]
    raw_origins = os.environ.get("MCP_ALLOWED_ORIGINS")
    if not raw_origins:
        return TransportSecuritySettings(allowed_hosts=allowed_hosts)
    allowed_origins = [
        origin.strip() for origin in raw_origins.split(",") if origin.strip()
    ]
    return TransportSecuritySettings(
        allowed_hosts=allowed_hosts, allowed_origins=allowed_origins
    )


def main(args: Sequence[str] | None = None) -> None:
    """Run the MCP server with stdio (default) or Streamable HTTP."""
    parser = argparse.ArgumentParser(description="MCP server for {{ repo_name }}")
    parser.add_argument(
        "--transport",
        choices=["stdio", "streamable-http"],
        default="stdio",
        help="Transport to use (default: stdio)",
    )
    parser.add_argument(
        "--host", default="127.0.0.1", help="Host to bind (streamable-http)"
    )
    parser.add_argument(
        "--port", type=int, default=8000, help="Port to bind (streamable-http)"
    )
    parsed = parser.parse_args(args)
    transport = cast(Literal["stdio", "streamable-http"], parsed.transport)
    if transport == "streamable-http":
        host = cast(str, parsed.host)
        port = cast(int, parsed.port)
        local_binds = ("127.0.0.1", "localhost", "::1")
        if host not in local_binds and not os.environ.get("MCP_ALLOWED_HOSTS"):
            parser.error(
                "binding to a non-local host requires MCP_ALLOWED_HOSTS "
                "(comma-separated host allowlist, e.g. "
                "MCP_ALLOWED_HOSTS=localhost,mcp.example.com) so the server "
                "does not accept every Host header"
            )
        server.run(
            transport=transport,
            host=host,
            port=port,
            transport_security=_allowed_hosts(),
        )
    else:
        server.run(transport="stdio")


if __name__ == "__main__":
    main()
