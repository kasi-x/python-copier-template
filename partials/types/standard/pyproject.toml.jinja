{% import "partials/macros.jinja" as m with context -%}
[build-system]
build-backend = "setuptools.build_meta"
requires = [ "setuptools>=77"{% if not no_pkg %}, "setuptools-scm[toml]>=8"{% endif %} ]

[project]
name = "{{ distribution_name }}"
description = "{{ description }}"
readme = "README.md"
{% if not proprietary -%}
license = "{{ license_effective }}"
{% endif -%}
license-files = [ "LICENSE" ]
authors = [
  # Further authors may be added by duplicating this section
  { name = "{{ author_name }}", email = "{{ author_email }}" }
]
{% if is_poetry %}requires-python = ">=3.11,<4.0"{% else %}requires-python = ">={{ m.python_version() }}"{% endif %}
classifiers = [
    "Development Status :: 3 - Alpha",
    {{ m.classifiers() }}]
{% if is_poetry %}{# poetry は setuptools-scm 由来の dynamic version を解釈しないため静的にする #}version = "0.1.0"
{% else %}dynamic = [ "version" ]
{% endif %}
dependencies = [{% for dep in dependencies %}"{{ dep }}", {% endfor %}]  # Add project dependencies here, e.g. ["click", "numpy"]
{% if is_gitlab %}urls.Homepage{% else %}urls.GitHub{% endif %} = "{{ repo_url }}"
scripts.{{ repo_name }} = "{{ package_name }}.__main__:main"
{% if mcp_effective %}scripts.mcp-server-{{ repo_name }} = "{{ import_pkg }}.mcp_server:main"
{% endif %}{% if bot_discord_effective %}scripts.bot-discord-{{ repo_name }} = "{{ import_pkg }}.bot_discord:main"
{% endif %}{% if bot_slack_effective %}scripts.bot-slack-{{ repo_name }} = "{{ import_pkg }}.bot_slack:main"
{% endif %}{% if bot_line_effective %}scripts.bot-line-{{ repo_name }} = "{{ import_pkg }}.bot_line:main"
{% endif %}{% if bot_gmail_effective %}scripts.bot-gmail-{{ repo_name }} = "{{ import_pkg }}.bot_gmail:main"
{% endif %}
{# The MicroPython firmware is not a pip-installable Python package: it is
   deployed to the device with mpremote. The [project] table above exists so
   the CPython dev toolchain (ruff/pytest/basedpyright) has a home, but there
   is no setuptools_scm git-tag version and nothing is built or installed. #}
[dependency-groups]{# dev deps: base body shared by every strictness tier + the `rec` guard
   appending the recommended/full-only additions. The docs/sphinx entries are
   captured once and spliced per tier: recommended/full render them before
   pytest (basedpyright leads the group), none/basic after ruff. #}{% set rec = not strictness_minimal %}{% set zensical_deps %}"zensical",
    "mkdocstrings[python]",
    {% endset %}{% set mpremote_deps %}"mpremote",
    {% endset %}{% set sphinx_theme_deps %}"pydata-sphinx-theme>=0.12",
    {% endset %}{% set sphinx_docs_deps %}"myst-parser",
    "sphinx-autobuild",
    "sphinx-copybutton",
    "sphinx-design",
    {% endset %}
dev = [
    {% if rec %}"basedpyright",
    {% if zensical %}{{ zensical_deps }}{% endif %}{% if micropython_pkg %}{{ mpremote_deps }}{% endif %}{% if sphinx %}{{ sphinx_theme_deps }}{% endif %}{% if type_checker=="pyrefly" %}"pyrefly",
    {% endif %}{% if type_checker=="ty" %}"ty",
    {% endif %}    {% endif %}"pytest",
    {% if rec %}"pytest-cov",
    {% endif %}"ruff",{% if mcp_effective or bot_discord_effective or bot_line_effective %}
    "anyio",{% endif %}{% if bot_line_effective and pkg_scaffold %}
    "httpx>=0.27,<1",{% endif %}
    {% if rec %}{% if sphinx %}{{ sphinx_docs_deps }}{% endif %}    {% endif %}{% if not rec %}{% if micropython_pkg %}{{ mpremote_deps }}{% endif %}{% if zensical %}{{ zensical_deps }}{% endif %}{% if sphinx %}{{ sphinx_theme_deps }}{{ sphinx_docs_deps }}{% endif %}{% endif %}{% if great_docs %}"great-docs",
    {% endif %}{% if rec %}    {% endif %}{% if ds_stack %}"ipykernel",
    "nbclient",
    "nbstripout",
    {% endif %}{% if ds_stack %}"pandas",
    "tomli",
    "quartodoc",
    {% endif %}{% if task_runner_effective == 'poe' %}"poethepoet",
    {% elif task_runner_effective == 'invoke' %}"invoke",
    {% elif task_runner_effective == 'duty' %}"duty",
    {% endif %}{% if rec %}{% if cloud_provider == 'aws' %}"boto3-stubs[{{ 'essential' if aws_services == 'essential' else aws_services }}]>=1.34.0",
    {% endif %}"types-mock",
    "vulture",
    "deptry",
    "typos",
    "coverage>=7.15.4,<8",
    "hypothesis>=6.130.0,<7.0",
    "pip-audit>=2.9.0,<3.0",
{% if rec and license_check_effective %}    "pip-licenses>=5.0,<6",
{% endif %}    "pyproject-fmt>=2.27.0,<3.0",
    "pytest-mock>=3.14.0,<4.0",
    "pytest-timeout>=2.4.0,<2.5",
    "pytest-xdist>=3.8.0,<3.9",
    {%- endif %}
]

{% if data_science or ctf_effective %}[project.optional-dependencies]
{% endif %}{% if ds_stack %}experiment = [
    # 実験・探索・デバッグ用の依存 (marimo / 可視化 / LLM API)。
    # uv: `uv sync --extra experiment` で追加インストール。
    # pixi: `[tool.pixi.feature.experiment]` として分離。
{{ m.experiment_pep508() }}]
{% endif %}
{% if ctf_effective %}ctf = [
    # CTF 参加者用の依存 (pwntools / z3-solver)。
    # uv: `uv sync --extra ctf` で追加インストール。
    "pwntools>=4.13,<5",
    "z3-solver>=4.13,<5",
]
{% endif %}

{% if is_pixi %}[tool.pixi.workspace]
channels = ["conda-forge"]
platforms = ["linux-64", "osx-arm64", "osx-64", "win-64"]

[tool.pixi.pypi-dependencies]
{% if micropython_pkg %}{# No editable install: the firmware is deployed with mpremote, not pip. #}
{% elif kaggle %}utils = { path = "src/utils", editable = true }
{% elif web_api %}app = { path = ".", editable = true }
{% else %}{{ package_name }} = { path = ".", editable = true }
{% endif %}

[tool.pixi.environments]
default = { solve-group = "default" }
dev = { features = ["dev"], solve-group = "default" }
{% if ds_stack %}experiment = { features = ["experiment"], solve-group = "default" }
{% endif %}
{% if ds_stack %}[tool.pixi.feature.experiment.pypi-dependencies]
{{ m.experiment_pixi() }}{% endif %}
{# lint/type-check/test/docs tasks live in the chosen task_runner's file
   instead (Taskfile.yml / justfile / Makefile / [tool.poe.tasks] / the
   [tool.pixi.feature.dev.tasks] below) — one definition regardless of
   package_manager. #}
{% if task_runner_effective == 'pixi' %}
{% import "partials/tasks-model.jinja" as _t with context %}
[tool.pixi.feature.dev.tasks]
{{ _t.pixi_tasks() }}
{% endif %}

{% endif %}{% if is_uv and use_gpu_effective %}
[[tool.uv.index]]
name = "pytorch-cu126"
url = "https://download.pytorch.org/whl/cu126"
explicit = true

[tool.uv.sources]
torch = { index = "pytorch-cu126" }
torchvision = { index = "pytorch-cu126" }
{% endif %}{% if not use_src_layout and agent_scaffold %}# Flat layout + agent scaffold: prompts/ at the repo root would otherwise be
# picked up by setuptools' automatic flat-layout discovery, so list the real
# packages explicitly.
[tool.setuptools]
packages = ["{{ package_name }}", "{{ package_name }}.tools"]
{% endif %}{% if not no_pkg %}[tool.setuptools_scm]
version_file = "{{ pkg_dir }}/_version.py"
# Publish pipelines generate first and `git init` later: without git
# metadata setuptools_scm aborts every uv sync, so fall back to a
# placeholder until the first commit provides the real version.
fallback_version = "0.0.0"
{% if ros2_pkg %}
# ros2 ament_python: no git-tag versioning; setup.py / package.xml own the version.
{% endif %}
{% endif %}
{% import "partials/macros.jinja" as m with context %}{% if strictness in ['recommended', 'full'] %}
[tool.basedpyright]
typeCheckingMode = "{{ 'strict' if strictness == 'full' else 'recommended' }}"
# Pin the language version to what the project actually targets
# (requires-python / .python-version): ros2 humble -> 3.10, jazzy -> 3.12,
# everything else 3.11. Without this basedpyright assumes its newest
# supported Python and lets newer-only syntax slip through.
pythonVersion = "{{ m.python_version() }}"
{% if micropython_pkg %}# The MicroPython layout ships no `{{ pkg_dir }}` package: its CPython-checked
# code is tests/ + firmware/core (the firmware/ device tree is covered by the
# dedicated firmware/pyrightconfig.json pass), matching the pyrefly/ty sections.
include = ["tests", "firmware/core"]{% else %}include = ["{{ pkg_dir }}", "tests"]{% endif %}
# tasks.py/duties.py: invoke/duty's own decorators (@task/@duty) and Context
# are only partially typed upstream, so an explicit `basedpyright tasks.py`
# (outside the `include` scan above) would otherwise be noisy.
# MicroPython's tools/micropython/freeze.py is a device-build script (docker
# image strings), excluded the same way as the firmware entry points below.
exclude = [{% if task_runner_effective == 'invoke' %}"tasks.py", {% endif %}{% if task_runner_effective == 'duty' %}"duties.py", {% endif %}{% if micropython_pkg %}"firmware/main.py", "firmware/boot.py", "firmware/board_config.py", {% endif %}{% if oj_code %}"**/test", "venv", ".venv", ".github", "docs", {% endif %}]
reportMissingImports = false # Ignore missing stubs in imported modules
reportMissingTypeStubs = false
{%- if strictness == 'recommended' %}
analyzeUnannotatedFunctions = false # 完全未注釈関数はスキップ（partial のみ。none はもっと緩い）
{%- endif %}{% if strictness == 'full' %}
# full: Any を許さない。外部 API も明示的に型を書く
reportAny = true
reportExplicitAny = true
reportUnknownParameterType = true
reportUnknownArgumentType = true
reportUnknownVariableType = true
{% endif %}
# 重複検出は ruff / vulture が担うので無効化（片方に寄せる）
reportPrivateUsage = false
reportUnusedParameter = false
reportUnusedFunction = false
reportUnusedImport = false
reportCallInDefaultInitializer = false # typer のデフォルト引数は正当
reportUnusedCallResult = false # argparse add_argument 等の副作用目的の呼び出しは正当
enableTypeIgnoreComments = true # # type: ignore も受け付ける（mypy 互換）
reportImplicitStringConcatenation = false # ruff の ISC 系（暗黙連結を推奨）と整合させる
{% if web_api %}
# slowapi (and similar FastAPI-ecosystem decorators) ships no type stubs, so
# @limiter.limit(...) would otherwise trip reportUntypedFunctionDecorator.
reportUntypedFunctionDecorator = false
{% endif %}{% endif %}{% import "partials/macros.jinja" as m with context %}{% if type_checker == 'pyrefly' and strictness in ['recommended', 'full'] %}
[tool.pyrefly]
# Match requires-python / .python-version: the interpreter the project
# actually targets (ros2 humble -> 3.10, ros2 jazzy -> 3.12, else 3.11).
python-version = "{{ m.python_version() }}"
{% if micropython_pkg %}project-includes = ["tests", "firmware/core"]
project-excludes = ["venv", ".venv", "firmware/main.py", "firmware/boot.py", "firmware/board_config.py", "firmware/manifest.py"]
{% else %}project-includes = ["{{ pkg_dir }}"]
project-excludes = ["venv", ".venv"]
{% endif %}
preset = "{{ 'strict' if strictness == 'full' else 'default' }}"

{% endif %}
{% if type_checker == 'ty' and strictness in ['recommended', 'full'] %}
[tool.ty]
# ty complements basedpyright with a second, independent analysis pass.
# CPython-side code only; the MicroPython firmware (firmware/) is checked by
# the dedicated firmware/pyrightconfig.json pass instead.
[tool.ty.src]
{% if micropython_pkg %}include = ["tests", "firmware/core"]
exclude = ["tools", ".venv", "firmware/main.py", "firmware/boot.py", "firmware/board_config.py", "firmware/manifest.py"]
{% else %}include = ["{{ pkg_dir }}", "tests"]
exclude = ["tools", ".venv"]
{% endif %}
{% if strictness == 'full' %}
[tool.ty.rules]
# full: treat unresolved references as errors.
possibly-unresolved-reference = "error"
{% endif %}
{% endif %}[tool.pytest.ini_options]
# Run pytest with all our checkers, and don't spam us with massive tracebacks on error
addopts = """
    --tb=native -vv{% if sphinx %} --doctest-modules --doctest-glob="*.rst"{% endif %}
    """
# https://iscinumpy.gitlab.io/post/bound-version-constraints/#watch-for-warnings
{# The Discord bot layer imports discord.py, which imports audioop (PEP 594):
   importing it warns on 3.11/3.12 (it is removed in 3.13, which discord.py
   guards) while the test module is collected, so that one not-ours warning is
   ignored before the blanket error. Renders without the bot keep the string
   form byte-for-byte. -#}
filterwarnings = {% if bot_discord_effective %}["error", "ignore:'audioop' is deprecated.*:DeprecationWarning"]{% else %}"error"{% endif %}
# Doctest python code in docs, python code in src docstrings, test functions in tests
testpaths = "{% if sphinx %}docs {% endif %}{{ 'tests' if no_pkg else (pkg_dir ~ ' tests') }}"


{% if strictness in ['recommended', 'full'] %}
[tool.coverage.run]
patch = ["subprocess"]
# Project-local data file: each generated project (and each parallel test
# worker copying it) writes its own .coverage instead of racing on a shared
# /tmp/<package>.coverage file.
data_file = ".coverage"

[tool.coverage.paths]
# Tests are run from installed location, map back to the src directory
source = ["{{ 'firmware' if micropython_pkg else pkg_dir }}", "**/site-packages/"]

[tool.coverage.report]
show_missing = true
skip_covered = true
skip_empty = true

[tool.typos.default]
# The guidance sections (rendered into AGENTS.md by `daimonion agents-md --write`)
# carry trigger-regex stems (`certificat`,
# `advertis` — deliberate word-stem matches), proper nouns (`certifi` the
# package, `HashiCorp`) and metric acronyms (`fpr`/`fnr` in its code
# examples) that the spellchecker must not correct. The marker line's
# `rulebook=<sha12>` stamp is a hex string whose letters the corrector
# reads as words, so the short hex stamp is ignored too. typos is report-only
# on purpose (no task runs `typos -w`: it applies single-correction
# dictionary words inside identifiers too, silently) -- these lists are
# what lets a legit acronym identifier pass that report instead of being
# renamed away.
extend-ignore-words-re = ['\b[A-Z]{3}\b', 'certifi', 'certificat', 'HashiCorp', 'advertis', 'fpr', 'fnr', '\b[0-9a-f]{12}\b']
extend-ignore-identifiers-re = ['\b[A-Z]{3}\b', 'certifi', 'certificat', 'HashiCorp', 'advertis', 'fpr', 'fnr', '\b[0-9a-f]{12}\b']

[tool.typos.files]
# docs のビルド出力 (site/) はチェック対象外。
extend-exclude = ["site"]

[tool.vulture]
paths = ["{{ 'firmware' if micropython_pkg else pkg_dir }}"]
min_confidence = 80

[tool.deptry]
# 依存はプロジェクト本体を含む。DEP002（未使用依存）は使い始めるまで出るので無視する。
# DEP004 pytest: pytest を import するのは tests/（fixture / raises /
# MonkeyPatch）だけであり、正当な dev 専用利用。mcp_server のテストも同じ
# ルールに触れるため、エンジン横断で無視する。
# DEP004 httpx: 同じく tests/ だけが import する（web_api の TestClient 代替と
# line bot のテストが ASGITransport / AsyncClient を使う）。dev 専用利用。
# DEP002 の web_api 系名前は web_api（またはその派生 effective）でのみ依存に現れる
# ので、その名前を他の構成に混入させない。残りの共有名（logging 系・rich 等）は
# どの pkg を持つプロジェクトでも deps に現れ得るため無条件に置く。
per_rule_ignores = "DEP002=httpx|pendulum|pydantic|rich|structlog|loguru|picologging|typer{% if web_api or include_web_api %}|alembic|asgi-correlation-id|asyncpg|fastapi|pydantic-settings|slowapi|sqlalchemy|uvicorn{% endif %}{% if prometheus_effective %}|prometheus-client{% endif %}{% if ds_stack %}|duckdb|ipykernel|jupyterlab|marimo|matplotlib|nbclient|nbstripout|openai|plotly|polars|pyarrow|seaborn|wandb{% endif %}{% if kaggle %}|hydra-core|lightgbm|omegaconf|optuna|pandas|pyyaml|torch|torchvision|xgboost{% endif %}{% if ctf_effective %}|pwntools|z3-solver{% endif %}{% if scraping_scrapy_effective %}|scrapy{% endif %}{% if scraping_memorious_effective %}|memorious4{% endif %}{% if scraping_playwright_effective %}|playwright{% endif %}{% if cloud_provider == 'aws' %}|boto3|botocore|boto3-stubs{% endif %}{% if cloud_provider == 'gcp' %}|google-cloud-storage{% endif %}{% if cloud_provider == 'azure' %}|azure-identity{% endif %},DEP003={{ package_name }}|requests{% if mcp_effective %}|starlette{% endif %}{% if micropython_pkg %},DEP001=mpremote|micropython|machine|board_config{% endif %}{% if mcp_effective %},DEP001=starlette{% endif %},DEP004=httpx|pytest"
# tasks.py/duties.py: root-level dev script, not project source -- deptry
# would otherwise flag invoke/duty as DEP004 (dev-only dep imported by "source")
exclude = ["tools", ".venv", ".pixi", ".task", "build", "dist"{% if micropython_pkg %}, "firmware"{% endif %}{% if task_runner_effective == 'invoke' %}, "tasks.py"{% endif %}{% if task_runner_effective == 'duty' %}, "duties.py"{% endif %}]

[tool.pyproject_fmt]
keep-full-version = true
no-generate-python-version-classifiers = true
{% endif %}

{% if task_runner_effective == 'poe' %}
{% import "partials/tasks-model.jinja" as _t with context %}
[tool.poe.tasks]
{{ _t.poe_tasks() }}
{% endif %}
[tool.ruff]
src = ["{{ 'firmware' if micropython_pkg else pkg_dir }}", "tests"]
# tools/ は MicroPython の freeze.py（端末依存スクリプト）を、.github/pages は
# 共有の CI ヘルパーを対象外とする。firmware エントリや ament の test/ は
# ファイルごと除外せず、per-file-ignores で必要なルールだけ無効化する。
extend-exclude = ["tools", ".github/pages", "alembic"{% if sphinx %}, "docs"{% endif %}, "*.md", "**/_version.py"]
line-length = {{ 88 if not allow_japanese else 120 }}
# 挙動を変える可能性があるため、自動修正は safe-fix に限定する。
unsafe-fixes = false
{% if not no_pkg %}lint.logger-objects = ["{{ import_pkg }}.logging_setup.get_logger"]
{% endif %}
{% if strictness in ['recommended', 'full'] %}lint.preview = true
lint.explicit-preview-rules = true
lint.select = ["ALL"]
{% elif strictness == 'basic' %}lint.select = [
    "B",
    "C4",  # flake8-comprehensions - https://docs.astral.sh/ruff/rules/#flake8-comprehensions-c4
    "E",
    "F",
    "N",
    "W",
    "I",
    "UP",
    "SLF",
    "S",
    "PT",
]
{% else %}lint.select = [
    "E",
    "F",
    "W",
    "I",
]
{% endif %}{% if strictness == 'full' %}lint.extend-ignore = [
    "SIM401",  # if-else-block-instead-of-dict-get
    "S101",    # assert-used
    "PT018",   # pytest-composite-assertion
]
{% elif strictness == 'recommended' %}lint.extend-ignore = [
    "ANN001",  # missing-type-function-argument
    "ANN002",  # missing-type-args
    "ANN003",  # missing-type-kwargs
    "ANN202",  # missing-return-type-private-function
    "ANN204",  # missing-return-type-special-method
    "ANN205",  # missing-return-type-static-method
    "ANN206",  # missing-return-type-class-method
    "ANN401",  # any-type
    "SIM401",  # if-else-block-instead-of-dict-get
    "S101",    # assert-used
    "PT018",   # pytest-composite-assertion
    "TD",
    "FIX",
    "T20",     # flake8-print
    "TRY002",  # raise-vanilla-class
    "TRY003",  # raise-vanilla-args
    "D10",     # undocumented-code
    "DOC",
    "D420",    # incorrect-section-order
    "D421",    # property-docstring-verb
    "PLR2004", # magic-value-comparison
    "PLR6301", # no-self-use
    "E1",      # pycodestyle indentation
    "E2",      # pycodestyle whitespace
    "E3",      # pycodestyle blank lines
    "E502",    # redundant-backslash
    "W391",    # too-many-newlines
    "COM812",  # missing-trailing-comma
    "ISC001",  # single-line-implicit-str-concat
    "TC",
    "CPY001",  # missing-copyright-notice
    "RUF105",  # noqa-comments
    "RUF106",  # rule-codes-in-suppression
    "RUF201",  # rule-codes-in-selectors
    "PLW1514", # unspecified-encoding
    "PT029",   # pytest-warns-without-warning
    "TID254",  # lazy-import-mismatch
    "TID255",  # lazy-import-immediately-resolved
    # Parsing naive input (user text, filenames, log timestamps) and then
    # attaching the project tz via `.replace(tzinfo=...)` is a common correct
    # pattern that DTZ007 cannot see; drop this ignore once formats carry %z.
    "DTZ007",  # call-datetime-strptime-without-zone
    "FA",
{% if allow_japanese %}    # Japanese docstrings: pydocstyle's D400/D403/D415 assume an ASCII
    # sentence ends with `.` and starts with a capital letter. Japanese text
    # ends with 。 and has no case, so these three rules are noise for a
    # Japanese project — the same relief line-length already gets (the
    # per-file blanket on logging_setup.py shows the same pattern). The
    # template's own generated docstrings keep ASCII punctuation, so this
    # only relaxes user-authored text.
    "D400",   # missing-trailing-period
    "D403",   # first-word-capitalized
    "D415",   # missing-end-punctuation
{% endif %}
{% if oj_code %}    # Contest-code relaxations: single-file submissions are written for
    # speed and the judge, not a shared codebase. Shadowing `input`,
    # ALL-CAPS variables (N, M, INF), unused locals/helpers and in-function
    # imports are idiomatic there, so they are excluded project-wide.
    "A001",   # builtin-variable-shadowing
    "A002",   # builtin-argument-shadowing
    "N802",   # non-lowercase-variable-in-function
    "N803",   # non-lowercase-variable-in-function  (引数)
    "N806",   # non-lowercase-variable-in-function  (関数内定数)
    "RUF059", # unused-unpacked-variable
    "F841",   # unused-variable
    "ARG001", # unused-function-argument
    "ARG002", # unused-method-argument
    "ARG003", # unused-class-method-argument
    "ARG004", # unused-static-method-argument
    "ARG005", # unused-lambda-argument
    "PLC0415",# import-outside-top-level
{% endif %}]
{% elif strictness == 'basic' %}lint.extend-ignore = [
    "ANN401",  # any-type
    "SIM401",  # if-else-block-instead-of-dict-get
    "S101",    # assert-used
    "PT018",   # pytest-composite-assertion
    "TD",
]
{% else %}lint.extend-ignore = [
    "ANN001",  # missing-type-function-argument
    "ANN002",  # missing-type-args
    "ANN003",  # missing-type-kwargs
    "ANN202",  # missing-return-type-private-function
    "ANN204",  # missing-return-type-special-method
    "ANN205",  # missing-return-type-static-method
    "ANN206",  # missing-return-type-class-method
    "ANN401",  # any-type
    "SIM401",  # if-else-block-instead-of-dict-get
    "S101",    # assert-used
    "PT018",   # pytest-composite-assertion
    "TD",
]
{% endif %}# Pin PT001 to the bare `@pytest.fixture` style the template ships:
# without this pin, a ruff default flip would silently restyle every test
# file. `ruff check --fix` rewrites `@pytest.fixture()` to the bare form.
lint.flake8-pytest-style.fixture-parentheses = false
lint.task-tags = [
