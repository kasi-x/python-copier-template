From 1a43d2b43c26b421022f9cf5c963821b0de50fd1 Mon Sep 17 00:00:00 2001
From: kasi-x <149961262+kasi-x@users.noreply.github.com>
Date: Tue, 8 Sep 2026 08:37:50 +0900
Subject: [PATCH] fix(cli): state clearly that unsafe-feature refusal writes
 nothing

The unsafe-features message was phrased as a suggestion, so users
believed generation had happened and looked for output files that were
never written. State the refusal and its consequence explicitly, and
point at both remedies (--trust flag, settings trust list).

Also document the CLI exit codes (1 error, 4 unsafe-feature refusal),
which were previously only discoverable from the source.

The wording was discussed while diagnosing real-world reports where
non-interactive generation silently produced nothing because --trust
was missing.
---
 copier/errors.py     |  5 +++--
 docs/faq.md          | 13 +++++++++++++
 tests/test_unsafe.py | 30 +++++++++++++++---------------
 3 files changed, 31 insertions(+), 17 deletions(-)

diff --git a/copier/errors.py b/copier/errors.py
index 7bfbd0a..0160178 100644
--- a/copier/errors.py
+++ b/copier/errors.py
@@ -161,8 +161,9 @@ class UnsafeTemplateError(CopierError):
         assert features
         s = "s" if len(features) > 1 else ""
         super().__init__(
-            f"Template uses potentially unsafe feature{s}: {', '.join(features)}.\n"
-            "If you trust this template, consider adding the `--trust` option when running `copier copy/update`."
+            f"Refusing to generate: template uses potentially unsafe feature{s}: {', '.join(features)}.\n"
+            "Nothing was written to the destination.\n"
+            "If you trust this template, re-run with the `--trust` option, or add it to the trust list in your Copier settings."
         )
 
 
diff --git a/docs/faq.md b/docs/faq.md
index 5f36b4b..da2ab98 100644
--- a/docs/faq.md
+++ b/docs/faq.md
@@ -234,3 +234,16 @@ passing HTTPS credentials to Git:
 - <https://git-scm.com/docs/gitcredentials>
 - <https://git-scm.com/book/en/v2/Git-Tools-Credential-Storage#_credential_caching>
 - <https://github.com/topics/git-credential-helper>
+
+## What exit codes does the Copier CLI use?
+
+| Exit code | Meaning                                                                       |
+|-----------|-------------------------------------------------------------------------------|
+| 0         | Success                                                                       |
+| 1         | An error occurred; a description was printed to `stderr`                      |
+| 4         | The template uses unsafe features and the command ran without `--trust`; nothing was generated |
+
+The exit code `4` lets scripts distinguish a refused generation (the
+destination is left untouched) from other failures. If you trust the
+template, re-run with `--trust` or list it in the
+[settings trust list](settings.md).
