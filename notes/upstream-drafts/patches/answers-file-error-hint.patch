From c81af842908d166f4d6fd2a4b2266848ec700e5a Mon Sep 17 00:00:00 2001
From: kasi-x <149961262+kasi-x@users.noreply.github.com>
Date: Tue, 8 Sep 2026 08:38:35 +0900
Subject: [PATCH] fix(cli): tell users the answers file must be relative to the
 destination

--answers-file rejects absolute paths with a bare "is not a relative
path" ValueError, which gives no hint about what to pass instead. State
the requirement and the expected form in the message itself.
---
 copier/errors.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/copier/errors.py b/copier/errors.py
index 7bfbd0a..e542d31 100644
--- a/copier/errors.py
+++ b/copier/errors.py
@@ -112,7 +112,10 @@ class PathNotRelativeError(PathError):
     """The path is not relative, but it should be."""
 
     def __init__(self, *, path: Path) -> None:
-        super().__init__(f'"{path}" is not a relative path')
+        super().__init__(
+            f'"{path}" is not a relative path. Pass the answers file as a path '
+            "relative to the destination directory, e.g. .copier-answers.yml"
+        )
 
 
 class ForbiddenPathError(PathError):
-- 
2.43.0

